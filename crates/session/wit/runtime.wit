package microcrab:session@0.1.0;

/// Runtime's complete binding surface; guests select their own smaller worlds.
world runtime {
  include microcrab:agent/agent@0.7.0;
  import microcrab:host/process@0.1.0;
  import microcrab:host/filesystem@0.1.0;
  import microcrab:host/net@0.1.0;
  import microcrab:host/text-read@0.1.0;
  import microcrab:host/text-write@0.1.0;
  import microcrab:host/file-mutation@0.1.0;
  import microcrab:host/cache-points@0.1.0;
  import microcrab:host/glob@0.1.0;
  import microcrab:host/grep@0.1.0;
  import microcrab:host/shell@0.1.0;
  import variables;
  import scoped-variables: microcrab:session/variables@0.1.1;
}
