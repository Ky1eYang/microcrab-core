package microcrab:session@0.2.0;

/// Governed SessionState access. Only a variable's dynamic value uses JSON.
interface variables {
  use microcrab:agent/host-info@0.8.0.{communication-error};

  enum visibility { visible, invisible, secret }
  enum persistence { persisted, ephemeral }
  enum role { runtime, client, agent }

  record variable-entry {
    name: string,
    /// One JSON value, including JSON null; not a metadata or change envelope.
    value-json: string,
  }
  record metadata-entry {
    name: string,
    visibility: visibility,
    persistence: persistence,
    owner: role,
    editors: list<role>,
  }
  record scoped-entry {
    name: string,
    value-json: string,
    visibility: visibility,
    persistence: persistence,
    editors: option<list<role>>,
  }
  record variable-change-set {
    set: list<variable-entry>,
    remove: list<string>,
    scoped-set: list<scoped-entry>,
  }
  record call-facts {
    session-id: string,
    /// Mode bound to admission of this tool call, not the live State mode.
    admitted-mode: option<string>,
    /// UTC Unix milliseconds sampled when this function is called.
    observed-at-unix-ms: u64,
  }

  /// Read one visible dynamic JSON value; absence is not JSON null.
  variable-get: func(name: string) -> result<string, communication-error>;
  /// Current SessionState projection, including governed ephemeral values.
  variable-get-all: func() -> result<list<variable-entry>, communication-error>;
  /// Custom-variable attributes, separate from value inspection.
  variable-metadata: func() -> result<list<metadata-entry>, communication-error>;
  /// Runtime stamps the caller role and applies Owner/Editors checks atomically.
  variable-change: func(change: variable-change-set) -> result<_, communication-error>;
  /// Read-only facts for a normal admitted tool call. Unavailable during
  /// discovery/init. These facts are not variables and cannot be injected.
  tool-call-facts: func() -> result<call-facts, communication-error>;
}
