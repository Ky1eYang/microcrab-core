package microcrab:session@0.1.0;

/// Optional Session communication; never a Host resource API.
interface variables {
  use microcrab:agent/host-info@0.8.0.{communication-error};
  /// Exact JSON value, including null; a missing name is absent.
  variable-get: func(name: string) -> result<string, communication-error>;
  /// Apply one atomic VariablesChange JSON object through the bound Session.
  variable-change: func(change: string) -> result<_, communication-error>;
}
