;; Shared source fixture types mirror the typed 0.4 shell contract.
(type $operation-code (enum "denied" "invalid-request" "unsupported" "conflict" "limit" "cancelled" "timeout" "io"))
(export "operation-error-code" (type $operation-code-public (eq $operation-code)))
(type $operation-error (record (field "code" $operation-code-public) (field "message" string)))
(export "operation-error" (type $operation-error-public (eq $operation-error)))
(type $shell-request (record (field "command" string) (field "cwd" (option string)) (field "timeout-ms" (option u64)) (field "yield-ms" u64)))
(export "shell-request" (type $shell-request-public (eq $shell-request)))
(type $shell-completed (record (field "stdout" string) (field "stderr" string) (field "exit-code" (option s32)) (field "truncated" bool)))
(export "shell-completed" (type $shell-completed-public (eq $shell-completed)))
(type $shell-job (record (field "job-id" u64) (field "session-id" string) (field "id" string) (field "pid" u32)))
(export "shell-job" (type $shell-job-public (eq $shell-job)))
(type $shell-output (variant (case "completed" $shell-completed-public) (case "started" $shell-job-public)))
(export "shell-output" (type $shell-output-public (eq $shell-output)))
(export "shell" (func (param "request" $shell-request-public) (result (result $shell-output-public (error $operation-error-public)))))
