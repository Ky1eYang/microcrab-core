package microcrab:agent@0.9.0;

/// Immutable discovery facts, available without operation grants.
interface host-info {
  enum communication-error-code { absent, unavailable, rejected, cancelled }
  record communication-error { code: communication-error-code, message: string }
  host-info: func() -> result<string, communication-error>;
}

/// Runtime-owned storage, independent of tool names and Host process identity.
interface execution {
  use microcrab:host/process@0.1.0.{process-handle};
  use microcrab:host/shell@0.1.0.{shell-request};
  enum failure-kind { failed, timeout, cancelled }
  record tool-failure { kind: failure-kind, code: string, message: string, retryable: bool }
  resource buffer;
  /// Copied binary output; Runtime validates media before Context admission.
  record media-attachment { media-type: string, data: list<u8> }
  /// Attachments belong only to Final; buffer append/finish remain UTF-8 output.
  record final-output { content: string, failure: option<tool-failure>, attachments: list<media-attachment> }
  record buffered-output { output: own<buffer>, include-initial: bool }
  variant tool-output { final(final-output), buffered(buffered-output) }
  record driver-step { state: list<u8>, wake-after-ms: u64, finished: bool }
  /// Bytes carry a declared MIME witness, not evidence of valid image content.
  variant content-kind { text, bytes(string) }
  record output-channel { name: string, kind: content-kind }
  enum process-source { raw-pipes, shell-text }
  create: func(channels: list<output-channel>) -> result<own<buffer>, tool-failure>;
  append: func(output: borrow<buffer>, channel: option<string>, content: string) -> result<_, tool-failure>;
  mark-truncated: func(output: borrow<buffer>) -> result<_, tool-failure>;
  finish: func(output: borrow<buffer>, failure: option<tool-failure>) -> result<_, tool-failure>;
  /// Adopt an invocation-owned Host process into public text capture.
  attach-process: func(output: borrow<buffer>, process: process-handle, source: process-source) -> result<_, tool-failure>;
  retain-process: func(output: borrow<buffer>, process: process-handle, source: process-source) -> result<_, tool-failure>;
  /// Runtime takes sole ownership at launch. Requires exactly one Bytes stdout
  /// channel; stderr is discarded and bytes are never returned to the guest.
  launch-private-shell: func(output: borrow<buffer>, request: shell-request) -> result<_, tool-failure>;
  /// Register copied continuation state, driven by Runtime after invoke returns.
  attach-guest: func(output: borrow<buffer>, state: list<u8>) -> result<_, tool-failure>;
}

world agent {
  record init-error { code: string, message: string }
  variant init-result { ready, failed(init-error) }
  /// Setup during initial Session initialization only; Runtime authorizes every effectful import.
  /// Later epochs, recovery and rebind do not rerun guest init.
  export init: func() -> init-result;
  import host-info;
  import execution;
  use execution.{tool-output, tool-failure, buffer, driver-step};
  export describe: func(host-info: string) -> result<string, string>;
  export invoke: func(host-info: string, name: string, arguments: string) -> result<tool-output, tool-failure>;
  /// Bounded continuation; cancellation requests cleanup, epoch end interrupts it.
  export drive: func(output: borrow<buffer>, state: list<u8>, cancelled: bool) -> result<driver-step, tool-failure>;
}
